generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(auto()) @map("_id") @db.ObjectId
  email                String                   @unique
  name                 String?
  passwordHash         String
  emailVerifiedAt      DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  rewardAccount        RewardAccount?
  transactions         RewardTransaction[]
  activities           SurveyActivity[]
  resetTokens          PasswordResetToken[]
  verificationTokens   EmailVerificationToken[]
  consents             ConsentRecord[]
  payoutAccount        PayoutAccount?
  withdrawals          Withdrawal[]
  referralCode         String                   @unique @default(cuid())
  referralsMade        Referral[]               @relation("ReferrerUsers")
  referralReceived     Referral?                @relation("ReferredUser")
  referrerCommissions  ReferralCommission[]     @relation("ReferrerCommissions")
  referredCommissions  ReferralCommission[]     @relation("ReferredCommissions")
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One acceptance of one policy version. Rows are inserted and never rewritten.
model ConsentRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    String
  version     String
  action      String
  acceptedAt  DateTime @default(now())
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, document, acceptedAt])
}

model RewardAccount {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @unique @db.ObjectId
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableUnits        Int      @default(0)
  reservedUnits         Int      @default(0)
  lifetimeCreditedUnits Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model RewardTransaction {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  userId         String             @db.ObjectId
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerTxId   String
  type           String
  amountUnits    Int
  appliedUnits   Int
  shortfallUnits Int                @default(0)
  currencyCode   String
  status         String
  surveyId       String?
  refTxId        String?
  reason         String?
  providerUsd    String?
  createdAt      DateTime           @default(now())
  activities     SurveyActivity[]

  @@unique([provider, providerTxId])
  @@index([userId, createdAt])
}

model SurveyActivity {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  userId        String             @db.ObjectId
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  surveyId      String
  status        String
  startedAt     DateTime?
  completedAt   DateTime?
  transactionId String?            @db.ObjectId
  transaction   RewardTransaction? @relation(fields: [transactionId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([userId, surveyId])
}

/// Idempotency anchor for a provider callback. userId stays a plain string so an
/// unknown or malformed provider user id can still be recorded.
model ProcessedCallback {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  provider     String
  providerTxId String
  outcome      String
  userId       String?
  type         String?
  createdAt    DateTime @default(now())

  @@unique([provider, providerTxId])
  @@index([createdAt])
}

model PostbackLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  provider     String
  providerTxId String?
  outcome      String
  userId       String?
  type         String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Verified Nigerian payout account. The full account number is not stored.
model PayoutAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCode      String
  bankName      String
  accountLast4  String
  accountName   String
  recipientCode String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Withdrawal {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  userId        String            @db.ObjectId
  user          User              @relation(fields: [userId], references: [id])
  points        Int
  amountKobo    Int
  /// Whole naira per dollar used to price this payout. Null on rows created before automatic batches.
  nairaPerUsd   Int?
  rateAt        DateTime?
  /// Dollar value in cents. For OPN this equals points, because 1 OPN is one cent.
  usdCents      Int?
  currency      String            @default("NGN")
  recipientCode String
  reference     String            @unique
  status        String
  failureReason String?
  transferCode  String?
  batchId       String?           @db.ObjectId
  batch         PayoutBatch?      @relation(fields: [batchId], references: [id])
  attempt       Int               @default(1)
  anomaly       String?
  requestedAt   DateTime          @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?           @db.ObjectId
  processingAt  DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  attempts      TransferAttempt[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Every reference sent to Paystack, including attempts that were replaced.
model TransferAttempt {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  withdrawalId  String     @db.ObjectId
  withdrawal    Withdrawal @relation(fields: [withdrawalId], references: [id])
  reference     String     @unique
  transferCode  String?
  status        String
  batchId       String?    @db.ObjectId
  failureReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([withdrawalId])
}

model PayoutBatch {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  status        String
  transferCount Int
  totalPoints   Int          @default(0)
  totalKobo     Int          @default(0)
  nairaPerUsd   Int?
  rateAt        DateTime?
  message       String?
  currency      String       @default("NGN")
  actorId       String?      @db.ObjectId
  submittedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  withdrawals   Withdrawal[]

  @@index([submittedAt])
  @@index([status, createdAt])
}

model PayoutAudit {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Null when no admin session exists, such as a verified Paystack webhook.
  actorId      String?  @db.ObjectId
  action       String
  withdrawalId String?  @db.ObjectId
  batchId      String?  @db.ObjectId
  detail       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([withdrawalId])
}

/// One row per raw webhook body. processedAt stays empty until settlement finishes.
model PaystackEvent {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  eventKey    String    @unique
  event       String
  reference   String?
  note        String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([reference])
}

/// Single document that spaces bulk submissions by at least five seconds.
model PayoutGate {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  key           String   @unique
  nextAllowedAt DateTime
}

/// One row controls the automatic payout heartbeat. Created paused so a deploy does not reserve funds.
model PayoutSchedule {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique
  intervalDays Int      @default(7)
  minUsdCents  Int      @default(500)
  nextRunAt    DateTime
  paused       Boolean  @default(true)
  lockedUntil  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Immutable naira-per-dollar prices. A new row replaces the previous one for future payouts only.
model PayoutFxPolicy {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nairaPerUsd Int
  effectiveAt DateTime
  expiresAt   DateTime
  actorId     String   @db.ObjectId
  note        String?
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

/// Fixed-window counter. The key includes the window start, so a retry increments one row.
model RateLimitBucket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

/// Security decision. Stores a keyed hash of the network subject, not the raw IP address.
model RiskEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  correlationId String
  userId        String?
  stage         String
  score         Int
  level         String
  action        String
  signals       String
  subjectHash   String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([stage, createdAt])
}

/// Payout or survey hold. Releasing it does not create a second credit.
model RiskReview {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String
  status        String
  scope         String
  score         Int
  level         String
  signals       String
  correlationId String
  note          String?
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
}

/// Equality key for a normalized email or bank fingerprint. The raw value is not stored.
model IdentityDigest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  kind      String
  digest    String
  createdAt DateTime @default(now())

  @@unique([userId, kind])
  @@index([kind, digest])
}

model RiskAudit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String
  reviewId  String
  action    String
  note      String
  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
}

model Referral {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  referrerId  String               @db.ObjectId
  referrer    User                 @relation("ReferrerUsers", fields: [referrerId], references: [id])
  referredId  String               @unique @db.ObjectId
  referred    User                 @relation("ReferredUser", fields: [referredId], references: [id])
  codeUsed    String
  source      String?
  createdAt   DateTime             @default(now())
  commissions ReferralCommission[]

  @@index([referrerId, createdAt])
}

model ReferralCommission {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  referralId          String    @db.ObjectId
  referral            Referral  @relation(fields: [referralId], references: [id])
  referrerId          String    @db.ObjectId
  referrer            User      @relation("ReferrerCommissions", fields: [referrerId], references: [id])
  referredId          String    @db.ObjectId
  referred            User      @relation("ReferredCommissions", fields: [referredId], references: [id])
  provider            String
  providerTxId        String
  eventType           String    // "CREDIT" | "REVERSAL"
  status              String    // "APPROVED" | "HELD" | "REVERSED"
  grossAmountUsd      String?
  userRewardUnits     Int
  opiniatedShareUnits Int
  commissionRateBps   Int
  amountUnits         Int
  currencyCode        String    @default("OPN")
  refTxId             String?
  holdReason          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([provider, providerTxId, eventType])
  @@index([referrerId, status, createdAt])
  @@index([referredId, createdAt])
}

model ReferralConfig {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique @default("default")
  commissionRateBps Int      @default(1000)
  enabled           Boolean  @default(true)
  updatedBy         String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model ReferralAudit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String?
  action    String
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}
