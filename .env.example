# MongoDB connection string used by Prisma.
# Reward credits and password resets use multi-document transactions, so the
# server must be a replica set. A single-node set is enough for local development.
DATABASE_URL=mongodb://127.0.0.1:27017/opiniated?replicaSet=rs0

# At least 32 characters. Used to encrypt the session cookie.
AUTH_SECRET=

# Public origin of this app. Used in password-reset links.
APP_URL=http://localhost:3000

# BitLabs app token. Sent as X-Api-Token. Found in the BitLabs dashboard for your app.
BITLABS_API_TOKEN=

# BitLabs app secret. Used to verify callback hashes (HMAC-SHA1 of the full URL).
# The current docs describe one app secret for this, not a separate postback secret.
# Confirm the value in the dashboard against:
# https://developer.bitlabs.ai/docs/securing-callbacks-through-hashing
BITLABS_SECRET=

# Exact public callback URL without a query string. The hash covers this URL plus
# the query BitLabs sends. Leave empty only when the app receives the same URL
# BitLabs calls. Behind a tunnel or reverse proxy, set the public URL.
# Example: https://example.com/api/bitlabs/postback
BITLABS_CALLBACK_URL=

# Set to true only when the deployment puts BitLabs on a trusted x-real-ip / x-forwarded-for
# header. Local tunnels should leave this false.
BITLABS_ENFORCE_IP_ALLOWLIST=false

# How BitLabs `value` is stored and shown.
# value is the user reward in the app currency from BitLabs Currency Settings.
# REWARD_MINOR_UNIT_FACTOR is the number of integer units in one major unit.
# PTS and 1 stores "120" as 120 points and displays "120 PTS".
# USD and 100 stores "1.20" as 120 cents and displays "$1.20".
# Confirm this against your BitLabs currency settings before showing amounts as cash.
REWARD_CURRENCY_CODE=OPN
REWARD_MINOR_UNIT_FACTOR=1

# Monitored support inbox shown on Contact, Privacy, Terms, and the footer.
# Required before a public launch. Do not invent an address in the application.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Cloudflare Turnstile. All three values are required before registration can succeed.
# The site key is public. The secret stays on the server and is sent only to
# https://challenges.cloudflare.com/turnstile/v0/siteverify
# TURNSTILE_HOSTNAMES is the frontend hostname for this deployment, comma-separated.
# Local development uses localhost. Production must list the public host only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost

# Resend, for password reset and email verification. Both values are required before those emails send.
# Verify the sending domain in Resend. EMAIL_FROM is a bare address or "Opiniated <you@your-domain>".
# Resend's shared sandbox sender, onboarding@resend.dev, can only mail the Resend account address.
# The API key stays on the server. If either value is empty or the from address is invalid, mail is not sent.
# Email verification is offered when both are set. It does not block survey access.
RESEND_API_KEY=
EMAIL_FROM=
